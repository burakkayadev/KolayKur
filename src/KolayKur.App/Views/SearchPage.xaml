<UserControl x:Class="KolayKur.App.Views.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:KolayKur.App.Views"
             xmlns:layout="clr-namespace:KolayKur.App.Views.Layout"
             xmlns:conv="clr-namespace:KolayKur.App.Converters"
             xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core">
    <!-- DataContext: SearchViewModel (ana pencere atar). Renkler yalnız DynamicResource ile Themes sözlüklerinden gelir. -->
    <UserControl.Resources>
        <conv:FormatTextConverter x:Key="FormatText" />
        <conv:NotNullToBoolConverter x:Key="NotNullToBool" />

        <!-- Sonuç yok, hata yok, yükleme yok: yönlendirme metni. -->
        <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Results.Count}" Value="0" />
                        <Condition Binding="{Binding ErrorKey}" Value="{x:Null}" />
                        <Condition Binding="{Binding IsLoading}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Kurulu değilse: "Kur" düğmesi görünür, "Kurulu" etiketi gizli; kuruluysa tersi. -->
        <Style x:Key="InstalledChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Package.InstalledVersion}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InstallButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Package.InstalledVersion}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VersionChipVisibilityStyle" TargetType="Border" BasedOn="{StaticResource VersionChipStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayVersion}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sonuç kartı; seçiliyken kenar 2 px marka rengi (dolgu 1 px azalır, içerik kaymaz). -->
        <Style x:Key="ResultCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
            <Setter Property="Padding" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="15" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ResultCardTemplate">
            <Border Style="{StaticResource ResultCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <views:PackageAvatarView Grid.Row="0" Grid.Column="0" VerticalAlignment="Top"
                                             PackageId="{Binding Package.Id}" PackageName="{Binding Package.Name}" PackageSource="{Binding Package.Source}"
                                             PackageIsInstalled="{Binding Package.InstalledVersion, Converter={StaticResource NotNullToBool}}" />

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,8,0">
                        <TextBlock Text="{Binding Package.Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   ToolTip="{Binding Package.Name}" />
                        <TextBlock Text="{Binding Package.Publisher}" Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,2,0,0" ToolTip="{Binding Package.Publisher}" />
                        <Border Style="{StaticResource StoreChipStyle}"
                                Visibility="{Binding Package.Source, Converter={StaticResource StoreSourceVisibility}}">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11"
                                       Text="{Binding [Source_MicrosoftStore], Source={x:Static loc:Loc.Instance}}" />
                        </Border>
                        <TextBlock Text="{Binding Package.Id}" Style="{StaticResource SecondaryTextStyle}"
                                   FontSize="11" Opacity="0.8" ToolTip="{Binding Package.Id}" />
                    </StackPanel>

                    <CheckBox Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" MinWidth="0" Padding="0"
                              IsChecked="{Binding IsSelected}"
                              AutomationProperties.Name="{Binding Package.Name}"
                              AutomationProperties.HelpText="{Binding Package.AccessibleLabel}" />

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource VersionChipVisibilityStyle}"
                                VerticalAlignment="Center" MaxWidth="140">
                            <TextBlock Text="{Binding DisplayVersion}" Style="{StaticResource SecondaryTextStyle}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource InstalledChipStyle}">
                            <TextBlock Text="{Binding [Search_Installed], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                        <ui:Button Grid.Column="1" Style="{StaticResource InstallButtonStyle}"
                                   Appearance="Primary" Padding="20,4"
                                   AutomationProperties.HelpText="{Binding Package.AccessibleLabel}"
                                   Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=views:SearchPage}}"
                                   CommandParameter="{Binding Package}"
                                   Content="{Binding [Search_Install], Source={x:Static loc:Loc.Instance}}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitleTextStyle}"
                   Text="{Binding [Menu_Search], Source={x:Static loc:Loc.Instance}}" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="SearchBox"
                        AutomationProperties.Name="{Binding [Search_Prompt], Source={x:Static loc:Loc.Instance}}"
                        PlaceholderText="{Binding [Search_Prompt], Source={x:Static loc:Loc.Instance}}"
                        ToolTip="{Binding [Search_Prompt], Source={x:Static loc:Loc.Instance}}"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="24,6" VerticalAlignment="Stretch"
                       Appearance="Primary"
                       AutomationProperties.AutomationId="SearchButton"
                       Command="{Binding SearchCommand}"
                       Content="{Binding [Search_Action], Source={x:Static loc:Loc.Instance}}" />
        </Grid>

        <layout:AdaptiveRowPanel Grid.Row="2" Margin="0,12,0,0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                           FontSize="14" Text="{Binding ResultCountText}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                               Text="{Binding [Common_Loading], Source={x:Static loc:Loc.Instance}}" />
                </StackPanel>
            </WrapPanel>
            <ui:Button VerticalAlignment="Center" Padding="16,5" Appearance="Secondary"
                       Command="{Binding InstallSelectedCommand}">
                <ui:Button.Content>
                    <MultiBinding Converter="{StaticResource FormatText}">
                        <Binding Path="[Search_InstallSelectedCount]" Source="{x:Static loc:Loc.Instance}" />
                        <Binding Path="SelectedCount" />
                    </MultiBinding>
                </ui:Button.Content>
            </ui:Button>
        </layout:AdaptiveRowPanel>

        <views:ErrorInfoBar Grid.Row="3" Margin="0,12,0,0"
                            ErrorKey="{Binding ErrorKey}" ShowRetry="True" RetryCommand="{Binding RetryCommand}" />

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource ResultCardTemplate}"
                              Style="{StaticResource CardGridItemsControlStyle}" />
            </ScrollViewer>

            <StackPanel Style="{StaticResource EmptyStateStyle}" VerticalAlignment="Top" Margin="0,24,0,0">
                <ui:SymbolIcon Symbol="Search24" FontSize="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding [Search_Empty], Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
