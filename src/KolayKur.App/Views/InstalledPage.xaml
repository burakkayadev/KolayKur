<UserControl x:Class="KolayKur.App.Views.InstalledPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:KolayKur.App.Views"
             xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core">
    <!-- DataContext: InstalledViewModel (ana pencere atar). Sayfa görünür olunca liste yüklenir (kod arkası). Renkler yalnız DynamicResource ile Themes sözlüklerinden gelir. -->
    <UserControl.Resources>
        <!-- Yüklü uygulama yok, hata yok, yükleme yok: bilgi metni. -->
        <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Packages.Count}" Value="0" />
                        <Condition Binding="{Binding ErrorKey}" Value="{x:Null}" />
                        <Condition Binding="{Binding IsLoading}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="InstalledCardTemplate">
            <Border Style="{StaticResource AppCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <views:PackageAvatarView Grid.Row="0" Grid.Column="0" VerticalAlignment="Top"
                                             PackageId="{Binding Id}" PackageName="{Binding Name}" />

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,2,0,0" ToolTip="{Binding Publisher}" />
                        <TextBlock Text="{Binding Id}" Style="{StaticResource SecondaryTextStyle}"
                                   FontSize="11" Opacity="0.8" ToolTip="{Binding Id}" />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0"
                            Style="{StaticResource VersionChipStyle}" MaxWidth="140">
                        <TextBlock Text="{Binding InstalledVersion}" Style="{StaticResource SecondaryTextStyle}"
                                   ToolTip="{Binding InstalledVersion}" />
                    </Border>

                    <ui:Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="16,4"
                               HorizontalAlignment="Stretch" Appearance="Secondary"
                               Icon="{ui:SymbolIcon Delete16}"
                               Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=views:InstalledPage}}"
                               CommandParameter="{Binding}"
                               Content="{Binding [Installed_Uninstall], Source={x:Static loc:Loc.Instance}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitleTextStyle}"
                   Text="{Binding [Menu_Installed], Source={x:Static loc:Loc.Instance}}" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                       FontSize="14" Text="{Binding CountText}" />
            <ui:Button Grid.Column="1" Margin="12,0,0,0" Padding="20,6" Appearance="Secondary"
                       Command="{Binding ExportCommand}"
                       Content="{Binding [Installed_Export], Source={x:Static loc:Loc.Instance}}" />
            <ui:Button Grid.Column="2" Margin="12,0,0,0" Padding="20,6" Appearance="Primary"
                       Command="{Binding ImportCommand}"
                       Content="{Binding [Installed_Import], Source={x:Static loc:Loc.Instance}}" />
        </Grid>

        <views:ErrorInfoBar Grid.Row="2" Margin="0,12,0,0"
                            ErrorKey="{Binding ErrorKey}" ShowRetry="{Binding CanRetry}"
                            RetryCommand="{Binding LoadCommand}" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Packages}" ItemTemplate="{StaticResource InstalledCardTemplate}"
                              Style="{StaticResource CardGridItemsControlStyle}" />
            </ScrollViewer>

            <StackPanel Style="{StaticResource EmptyStateStyle}" VerticalAlignment="Top" Margin="0,24,0,0">
                <ui:SymbolIcon Symbol="Apps24" FontSize="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding [Installed_Empty], Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding [Common_Loading], Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
