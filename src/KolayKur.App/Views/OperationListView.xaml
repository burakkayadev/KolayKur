<UserControl x:Class="KolayKur.App.Views.OperationListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:KolayKur.App"
             xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core"
             xmlns:models="clr-namespace:KolayKur.Core.Models;assembly=KolayKur.Core">
    <!-- DataContext: OperationListViewModel (ana pencere atar). -->
    <UserControl.Resources>
        <app:OperationTextConverter x:Key="OperationText" />

        <Style x:Key="EmptyTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemProgressStyle" TargetType="ProgressBar">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationStatus.Running}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
                    <Setter Property="IsIndeterminate" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemStatusStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationStatus.Failed}">
                    <Setter Property="Foreground" Value="Firebrick" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationStatus.NotFound}">
                    <Setter Property="Foreground" Value="Firebrick" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Text="{Binding SummaryText}" />
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding [OperationList_Title], Source={x:Static loc:Loc.Instance}}" />
        </DockPanel>

        <Grid>
            <TextBlock Style="{StaticResource EmptyTextStyle}" VerticalAlignment="Top"
                       Text="{Binding [OperationList_Empty], Source={x:Static loc:Loc.Instance}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource OperationText}" ConverterParameter="Kind">
                                            <Binding Path="Kind" />
                                            <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Package.Name}" ToolTip="{Binding Package.Id}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ItemStatusStyle}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource OperationText}" ConverterParameter="Status">
                                            <Binding Path="Status" />
                                            <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ProgressBar Grid.Column="3" Height="6" Margin="0,0,12,0" VerticalAlignment="Center"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Percent, Mode=OneWay}"
                                             Style="{StaticResource ItemProgressStyle}" />
                                <TextBlock Grid.Column="4" Foreground="Gray" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Message}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource OperationText}" ConverterParameter="Message">
                                            <Binding Path="Status" />
                                            <Binding Path="Message" />
                                            <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
