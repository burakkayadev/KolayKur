<UserControl x:Class="KolayKur.App.Views.RepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:KolayKur.App"
             xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core">
    <!-- DataContext: RepairViewModel (kabuk, Repair özelliğini bağlar). -->
    <UserControl.Resources>
        <app:LocKeyConverter x:Key="LocKey" />
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="Firebrick" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorKey}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="{Binding [Repair_Title], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="{Binding [Repair_Intro], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LocKey}">
                    <Binding Path="ReasonKey" />
                    <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="{Binding [Repair_Note], Source={x:Static loc:Loc.Instance}}" />

        <Button Margin="0,20,0,0" Padding="24,8" HorizontalAlignment="Left"
                Command="{Binding RepairCommand}"
                Content="{Binding [Repair_Action], Source={x:Static loc:Loc.Instance}}" />

        <StackPanel Margin="0,16,0,0"
                    Visibility="{Binding RepairCommand.IsRunning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding [Repair_Working], Source={x:Static loc:Loc.Instance}}" />
            <ProgressBar Height="6" Margin="0,6,0,0" IsIndeterminate="True" />
            <TextBlock Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{Binding StatusText}" />
        </StackPanel>

        <TextBlock Style="{StaticResource ErrorTextStyle}">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource LocKey}">
                    <Binding Path="ErrorKey" />
                    <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </StackPanel>
</UserControl>
