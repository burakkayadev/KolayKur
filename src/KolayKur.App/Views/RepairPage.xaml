<UserControl x:Class="KolayKur.App.Views.RepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:KolayKur.App"
             xmlns:views="clr-namespace:KolayKur.App.Views"
             xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core">
    <!-- DataContext: RepairViewModel (kabuk, Repair özelliğini bağlar). Renkler yalnız DynamicResource ile. -->
    <UserControl.Resources>
        <app:LocKeyConverter x:Key="LocKey" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="560" Margin="0,24,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                Style="{StaticResource AppCardStyle}" Padding="24">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" FontSize="22" TextWrapping="Wrap"
                           Text="{Binding [Repair_Title], Source={x:Static loc:Loc.Instance}}" />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding [Repair_Intro], Source={x:Static loc:Loc.Instance}}" />
                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocKey}">
                            <Binding Path="ReasonKey" />
                            <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                           Style="{StaticResource SecondaryTextStyle}" TextTrimming="None"
                           Text="{Binding [Repair_Note], Source={x:Static loc:Loc.Instance}}" />

                <ui:Button Margin="0,20,0,0" Padding="24,8" HorizontalAlignment="Left" Appearance="Primary"
                           Command="{Binding RepairCommand}"
                           Content="{Binding [Repair_Action], Source={x:Static loc:Loc.Instance}}" />

                <!-- Çalışırken: dönen halka, "çalışıyor" metni ve aşama durumu. -->
                <StackPanel Margin="0,16,0,0" Orientation="Horizontal"
                            Visibility="{Binding RepairCommand.IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" VerticalAlignment="Top" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="440">
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding [Repair_Working], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}" TextTrimming="None"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                </StackPanel>

                <views:ErrorInfoBar Margin="0,16,0,0" ErrorKey="{Binding ErrorKey}" ShowRetry="False" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
