<UserControl x:Class="KolayKur.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:KolayKur.App"
             xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core">
    <!-- DataContext: SettingsViewModel (ana pencere atar). Dil seçimi anında uygulanır ve kaydedilir. -->
    <UserControl.Resources>
        <app:LocKeyConverter x:Key="LocKey" />
    </UserControl.Resources>

    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock FontSize="26" FontWeight="SemiBold"
                   Text="{Binding [Menu_Settings], Source={x:Static loc:Loc.Instance}}" />

        <TextBlock Margin="0,20,0,0" FontWeight="SemiBold"
                   Text="{Binding [Settings_Language], Source={x:Static loc:Loc.Instance}}" />
        <ComboBox Margin="0,6,0,0" Width="200" HorizontalAlignment="Left"
                  SelectedValuePath="Tag"
                  SelectedValue="{Binding Language}">
            <ComboBoxItem Tag="tr" Content="{Binding [Language_Tr], Source={x:Static loc:Loc.Instance}}" />
            <ComboBoxItem Tag="en" Content="{Binding [Language_En], Source={x:Static loc:Loc.Instance}}" />
        </ComboBox>

        <TextBlock Margin="0,24,0,0" FontWeight="SemiBold"
                   Text="{Binding [Settings_WingetStatus], Source={x:Static loc:Loc.Instance}}" />
        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
            <TextBlock>
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource LocKey}">
                        <Binding Path="StatusKey" />
                        <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Margin="8,0,0,0" Foreground="Gray" Text="{Binding WingetVersion}" />
        </StackPanel>

        <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
            <Button Padding="24,8" Command="{Binding OpenRepairCommand}"
                    Content="{Binding [Settings_Repair], Source={x:Static loc:Loc.Instance}}" />
            <Button Margin="12,0,0,0" Padding="24,8" Command="{Binding OpenLogCommand}"
                    Content="{Binding [Settings_OpenLog], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
