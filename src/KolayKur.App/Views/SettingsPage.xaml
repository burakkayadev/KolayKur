<UserControl x:Class="KolayKur.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:KolayKur.App"
             xmlns:conv="clr-namespace:KolayKur.App.Converters"
             xmlns:support="clr-namespace:KolayKur.Core.Support;assembly=KolayKur.Core"
             xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core">
    <!-- DataContext: SettingsViewModel (ana pencere atar). Dil ve tema seçimi anında uygulanır ve kaydedilir. Renkler yalnız DynamicResource ile. -->
    <UserControl.Resources>
        <app:LocKeyConverter x:Key="LocKey" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:FormatTextConverter x:Key="FormatText" />

        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="RowDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style x:Key="SettingsRowStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MinWidth="560" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,16,0">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,16"
                       Text="{Binding [Menu_Settings], Source={x:Static loc:Loc.Instance}}" />

            <!-- Tema: bölümlü görünümde üç RadioButton; Theme özelliğine EnumEqualsConverter ile bağlı. -->
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitleStyle}"
                                   Text="{Binding [Theme_Title], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource RowDescriptionStyle}"
                                   Text="{Binding [Theme_Description], Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" Padding="3" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Theme" Style="{StaticResource SegmentButtonStyle}"
                                         AutomationProperties.AutomationId="ThemeSystem"
                                         Content="{Binding [Theme_System], Source={x:Static loc:Loc.Instance}}"
                                         IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static support:AppTheme.System}}" />
                            <RadioButton GroupName="Theme" Style="{StaticResource SegmentButtonStyle}"
                                         AutomationProperties.AutomationId="ThemeLight"
                                         Content="{Binding [Theme_Light], Source={x:Static loc:Loc.Instance}}"
                                         IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static support:AppTheme.Light}}" />
                            <RadioButton GroupName="Theme" Style="{StaticResource SegmentButtonStyle}"
                                         AutomationProperties.AutomationId="ThemeDark"
                                         Content="{Binding [Theme_Dark], Source={x:Static loc:Loc.Instance}}"
                                         IsChecked="{Binding Theme, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static support:AppTheme.Dark}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Dil -->
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitleStyle}"
                                   Text="{Binding [Settings_Language], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource RowDescriptionStyle}"
                                   Text="{Binding [Settings_LanguageDescription], Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="160" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="LanguageSelector"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding Language}">
                        <ComboBoxItem Tag="tr" Content="{Binding [Language_Tr], Source={x:Static loc:Loc.Instance}}" />
                        <ComboBoxItem Tag="en" Content="{Binding [Language_En], Source={x:Static loc:Loc.Instance}}" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Winget durumu -->
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitleStyle}"
                                   Text="{Binding [Settings_WingetStatus], Source={x:Static loc:Loc.Instance}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKey}">
                                        <Binding Path="StatusKey" />
                                        <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding WingetVersion}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:Button Grid.Column="1" VerticalAlignment="Center" Padding="20,6" Appearance="Secondary"
                               Command="{Binding OpenRepairCommand}"
                               Content="{Binding [Settings_Repair], Source={x:Static loc:Loc.Instance}}" />
                </Grid>
            </Border>

            <!-- Günlük -->
            <Border Style="{StaticResource SettingsRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitleStyle}"
                                   Text="{Binding [Settings_OpenLog], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource RowDescriptionStyle}"
                                   Text="{Binding [Settings_LogDescription], Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" VerticalAlignment="Center" Padding="20,6" Appearance="Secondary"
                               Command="{Binding OpenLogCommand}"
                               Content="{Binding [Settings_OpenLog], Source={x:Static loc:Loc.Instance}}" />
                </Grid>
            </Border>

            <!-- Hakkında -->
            <Border Style="{StaticResource SettingsRowStyle}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource LogoImage}" Width="28" Height="28" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitleStyle}"
                                   Text="{Binding [App_Title], Source={x:Static loc:Loc.Instance}}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryTextStyle}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource FormatText}">
                                    <Binding Path="[About_Version]" Source="{x:Static loc:Loc.Instance}" />
                                    <Binding Path="AppVersion" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
