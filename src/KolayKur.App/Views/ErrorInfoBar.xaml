<UserControl x:Class="KolayKur.App.Views.ErrorInfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:KolayKur.App"
             xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core"
             x:Name="Root">
    <!-- ErrorKey (Strings anahtarı) doluyken hata bilgi çubuğu açılır; ShowRetry iken "Tekrar dene" düğmesi RetryCommand'ı çalıştırır. -->
    <UserControl.Resources>
        <app:LocKeyConverter x:Key="LocKey" />
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorKey, ElementName=Root}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Error">
        <ui:InfoBar.Title>
            <MultiBinding Converter="{StaticResource LocKey}">
                <Binding Path="ErrorKey" ElementName="Root" />
                <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
            </MultiBinding>
        </ui:InfoBar.Title>
        <Button HorizontalAlignment="Right" Padding="16,4"
                Command="{Binding RetryCommand, ElementName=Root}"
                Content="{Binding [Error_Retry], Source={x:Static loc:Loc.Instance}}"
                Visibility="{Binding ShowRetry, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
    </ui:InfoBar>
</UserControl>
