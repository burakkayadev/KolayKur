<UserControl x:Class="KolayKur.App.Views.OperationsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:KolayKur.App"
             xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core"
             xmlns:models="clr-namespace:KolayKur.Core.Models;assembly=KolayKur.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- DataContext: OperationListViewModel (ana pencere atar). Renkler yalnızca DynamicResource ile gelir. -->
    <UserControl.Resources>
        <app:OperationTextConverter x:Key="OperationText" />

        <Style x:Key="EmptyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="Margin" Value="16,4,16,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Özet metni yoksa (yeni toplu iş sürerken) alt çubuk görünmez. -->
        <Style x:Key="SummaryBarStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SummaryText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemProgressStyle" TargetType="ProgressBar">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationStatus.Running}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
                    <Setter Property="IsIndeterminate" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationStatus.Succeeded}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationStatus.Failed}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationStatus.NotFound}">
                    <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationStatus.Running}">
                    <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ayrıntı metni boşsa (sırada, başarılı) satır yer kaplamaz. -->
        <Style x:Key="ItemDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DetailText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sanallaştırılmış, kaydırılabilir liste: 500 işe kadar yalnızca görünen kartlar oluşturulur. -->
        <ControlTemplate x:Key="ItemListTemplate" TargetType="ItemsControl">
            <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="{TemplateBinding Padding}">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık: ad, Bitenleri temizle, kapat. -->
            <Grid Grid.Row="0" Margin="16,12,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding [OperationList_Title], Source={x:Static loc:Loc.Instance}}" />

                <Button Grid.Column="1" Margin="8,0,4,0" Padding="10,4" VerticalAlignment="Center"
                        Command="{Binding ClearFinishedCommand}"
                        Content="{Binding [Ops_ClearFinished], Source={x:Static loc:Loc.Instance}}" />

                <Button Grid.Column="2" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                        Command="{Binding ClosePaneCommand}"
                        AutomationProperties.Name="{Binding [Ops_ClosePane], Source={x:Static loc:Loc.Instance}}"
                        ToolTip="{Binding [Ops_ClosePane], Source={x:Static loc:Loc.Instance}}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock Style="{StaticResource EmptyTextStyle}"
                           Text="{Binding [OperationList_Empty], Source={x:Static loc:Loc.Instance}}" />

                <ItemsControl ItemsSource="{Binding Items}" Template="{StaticResource ItemListTemplate}"
                              Padding="12,0,12,8"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AppCardStyle}" Padding="12,10" Margin="0,0,0,8"
                                    ToolTip="{Binding TechnicalDetail, Mode=OneWay}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Package.Name}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryTextStyle}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource OperationText}" ConverterParameter="Kind">
                                                    <Binding Path="Kind" />
                                                    <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource ItemStatusStyle}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource OperationText}" ConverterParameter="Status">
                                                <Binding Path="Status" />
                                                <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource ItemDetailStyle}"
                                               Text="{Binding DetailText, Mode=OneWay}" />

                                    <ProgressBar Height="4" Margin="0,8,0,0"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 Style="{StaticResource ItemProgressStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Alt: son toplu işin özeti. -->
            <Border Grid.Row="2" Style="{StaticResource SummaryBarStyle}">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                           Text="{Binding SummaryText}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
