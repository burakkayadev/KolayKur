<Window x:Class="KolayKur.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KolayKur.Core.Localization;assembly=KolayKur.Core"
        xmlns:vm="clr-namespace:KolayKur.Core.ViewModels;assembly=KolayKur.Core"
        xmlns:views="clr-namespace:KolayKur.App.Views"
        Title="{Binding [App_Title], Source={x:Static loc:Loc.Instance}}"
        Width="1000" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Sayfa içeriği winget denetimi sürerken gösterilmez: onarım ekranı diğer sayfalardan önce gelir. -->
        <Style x:Key="SearchHostStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CurrentPage}" Value="Search" />
                        <Condition Binding="{Binding IsChecking}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UpdatesHostStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CurrentPage}" Value="Updates" />
                        <Condition Binding="{Binding IsChecking}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InstalledHostStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CurrentPage}" Value="Installed" />
                        <Condition Binding="{Binding IsChecking}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsHostStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CurrentPage}" Value="Settings" />
                        <Condition Binding="{Binding IsChecking}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RepairHostStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Repair">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" BorderThickness="0,0,1,0"
                     IsEnabled="{Binding IsMenuEnabled}"
                     SelectedValuePath="Tag"
                     SelectedValue="{Binding CurrentPage}"
                     ItemContainerStyle="{StaticResource MenuItemStyle}">
                <ListBoxItem Tag="{x:Static vm:ShellPage.Search}"
                             Content="{Binding [Menu_Search], Source={x:Static loc:Loc.Instance}}" />
                <ListBoxItem Tag="{x:Static vm:ShellPage.Updates}"
                             Content="{Binding [Menu_Updates], Source={x:Static loc:Loc.Instance}}" />
                <ListBoxItem Tag="{x:Static vm:ShellPage.Installed}"
                             Content="{Binding [Menu_Installed], Source={x:Static loc:Loc.Instance}}" />
                <ListBoxItem Tag="{x:Static vm:ShellPage.Settings}"
                             Content="{Binding [Menu_Settings], Source={x:Static loc:Loc.Instance}}" />
            </ListBox>

            <Grid Grid.Column="1" Margin="24">
                <!-- Sayfa ViewModel'leri MainWindow kurucusunda atanır; kabuğun DataContext'i yalnızca bu sarmalayıcılarda geçerlidir. -->
                <Grid Style="{StaticResource SearchHostStyle}">
                    <views:SearchPage x:Name="searchPage" />
                </Grid>

                <Grid Style="{StaticResource UpdatesHostStyle}">
                    <views:UpdatesPage x:Name="updatesPage" />
                </Grid>

                <Grid Style="{StaticResource InstalledHostStyle}">
                    <views:InstalledPage x:Name="installedPage" />
                </Grid>

                <Grid Style="{StaticResource SettingsHostStyle}">
                    <views:SettingsPage x:Name="settingsPage" />
                </Grid>

                <Grid Style="{StaticResource RepairHostStyle}">
                    <views:RepairPage DataContext="{Binding Repair}" />
                </Grid>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                           Text="{Binding [Startup_Checking], Source={x:Static loc:Loc.Instance}}"
                           Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <!-- Alt alan: işlem listesi. -->
        <Border Grid.Row="1" Height="150" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="16,10">
            <views:OperationListView x:Name="operationList" />
        </Border>
    </Grid>
</Window>
