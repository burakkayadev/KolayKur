<Application x:Class="KolayKur.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:KolayKur.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Sıra önemlidir: WPF-UI, sonra marka belirteçleri (WpfUiThemeService Brand.* sözlüğünü aynı yerde değiştirir), sonra stiller. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Brand.Light.xaml" />
                <ResourceDictionary Source="Themes/Logo.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:StoreSourceVisibilityConverter x:Key="StoreSourceVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
