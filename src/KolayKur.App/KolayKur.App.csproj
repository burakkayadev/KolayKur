<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Yayınlanan dosya KolayKur.exe olur. -->
    <AssemblyName>KolayKur</AssemblyName>
    <RootNamespace>KolayKur.App</RootNamespace>
    <!-- Tek dosya yayınında exe'yi sıkıştırır (yaklaşık 71 MB; açılış süresi yaklaşık 1-3 sn). Yalnızca yayında etkilidir. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/KolayKur.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Tek exe: winmd, WinmdBootstrapper tarafından açılışta programın yanına çıkarılır (yayın klasörüne ayrıca kopyalanmaz).
    Mantıksal ad, WinmdBootstrapper.WinmdFileName ile aynı olmalıdır.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.windowspackagemanager.cominterop/$(ComInteropVersion)/lib/uap10.0/Microsoft.Management.Deployment.winmd"
                      LogicalName="Microsoft.Management.Deployment.winmd"
                      Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/KolayKur.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KolayKur.Core\KolayKur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
