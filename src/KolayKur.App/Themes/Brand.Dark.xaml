<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Koyu tema belirteçleri. Sayfalar renk yazmaz; bu anahtarlar DynamicResource ile kullanılır. Açık ve koyu sözlükte anahtarlar aynıdır. -->
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#3DD6C6" />
    <SolidColorBrush x:Key="BrandAccentForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <!-- Mica yokken FluentWindow'un düz zemini de pencere zemini olsun. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#272727" />
    <SolidColorBrush x:Key="CardBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#393939" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#1F3A1F" />
    <SolidColorBrush x:Key="CautionBrush" Color="#FCE100" />

    <!-- Simge zemini: şeffaf simgeler iki temada da okunsun diye açık, tarafsız bir levha. -->
    <SolidColorBrush x:Key="IconPlateBrush" Color="#E6E6E8" />

    <!-- Harf avatarı paleti (beyaz harfle en az 4.5:1); iki temada aynı. -->
    <SolidColorBrush x:Key="AvatarBrush0" Color="#1F5FA8" />
    <SolidColorBrush x:Key="AvatarBrush1" Color="#B33A1A" />
    <SolidColorBrush x:Key="AvatarBrush2" Color="#4752C4" />
    <SolidColorBrush x:Key="AvatarBrush3" Color="#0E7C7B" />
    <SolidColorBrush x:Key="AvatarBrush4" Color="#B42318" />
    <SolidColorBrush x:Key="AvatarBrush5" Color="#6F42C1" />
    <SolidColorBrush x:Key="AvatarBrush6" Color="#3C873A" />
    <SolidColorBrush x:Key="AvatarBrush7" Color="#5B5B66" />
</ResourceDictionary>
